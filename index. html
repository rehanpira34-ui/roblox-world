<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rehan's Roblox World</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#05050a;
  color:white;
  line-height:1.5;
}

nav{
  position:sticky;
  top:0;
  z-index:10;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 6%;
  background:rgba(5,5,10,.95);
  border-bottom:1px solid #6f35ff;
}

.logo{
  font-size:21px;
  font-weight:bold;
  color:#a66cff;
}

nav a{
  color:#ddd;
  text-decoration:none;
  margin-left:20px;
  font-size:14px;
}

.hero{
  min-height:75vh;
  padding:70px 6%;
  display:flex;
  align-items:center;
  background:
    radial-gradient(circle at 75% 35%,rgba(126,55,255,.3),transparent 30%),
    linear-gradient(135deg,#090912,#13072b,#05050a);
}

.hero-text{
  max-width:700px;
}

.badge{
  color:#a66cff;
  font-weight:bold;
  letter-spacing:2px;
}

h1{
  font-size:clamp(45px,8vw,80px);
  line-height:.95;
  margin:15px 0;
}

h1 span{
  color:#9b55ff;
}

.hero p{
  color:#bbb;
  max-width:550px;
  margin:20px 0;
}

.btn{
  display:inline-block;
  padding:13px 22px;
  margin:5px;
  border-radius:10px;
  text-decoration:none;
  color:white;
  font-weight:bold;
  background:linear-gradient(90deg,#6b25ff,#4d8dff);
}

.btn.alt{
  background:transparent;
  border:1px solid #8d43ff;
}

section{
  padding:55px 6%;
}

.title{
  font-size:32px;
  margin-bottom:25px;
}

.title span{
  color:#a55cff;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
  margin-top:30px;
}

.card{
  background:linear-gradient(145deg,#11111c,#0b0b12);
  border:1px solid #29233b;
  border-radius:16px;
  padding:20px;
}

.stat b{
  display:block;
  font-size:28px;
}

.stat small{
  color:#999;
}

.profile-history,
.sub-goal{
  max-width:600px;
  margin:25px auto;
  text-align:center;
}

.history-card,
.goal-box{
  background:#202020;
  padding:20px;
  border-radius:18px;
}

.history-card p{
  margin:10px;
}

.goal-text{
  font-size:22px;
  font-weight:bold;
  margin-bottom:15px;
}

.progress-bg{
  width:100%;
  height:18px;
  background:#444;
  border-radius:20px;
  overflow:hidden;
}

#progressBar{
  width:1%;
  height:100%;
  background:#00ff66;
}

.song-card{
  max-width:420px;
  margin:30px auto;
  padding:25px;
  text-align:center;
  border-radius:20px;
  background:#1d1d1d;
}

.song-card a{
  display:inline-block;
  margin-top:15px;
  padding:12px 22px;
  border-radius:30px;
  background:white;
  color:#111;
  text-decoration:none;
  font-weight:bold;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
}

.game h3{
  margin-bottom:5px;
}

.game p{
  color:#999;
}

.timeline .item{
  border-left:3px solid #8d43ff;
  padding:0 0 25px 20px;
  margin-left:8px;
}

.timeline .year{
  color:#a55cff;
  font-weight:bold;
}

#mini-game{
  text-align:center;
}

#gameBox{
  max-width:600px;
  height:350px;
  margin:auto;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#12052b,#090912);
  border:2px solid #8d43ff;
  border-radius:20px;
}

#coin{
  position:absolute;
  left:50%;
  top:55%;
  width:65px;
  height:65px;
  transform:translate(-50%,-50%);
  border:0;
  border-radius:50%;
  background:#ffd43b;
  font-size:30px;
  cursor:pointer;
}

#gameMessage{
  position:absolute;
  bottom:20px;
  width:100%;
  color:#bbb;
  font-weight:bold;
}

.play-game{
  margin-top:18px;
  padding:13px 25px;
  border:0;
  border-radius:10px;
  background:linear-gradient(90deg,#6b25ff,#4d8dff);
  color:white;
  font-weight:bold;
  cursor:pointer;
}

footer{
  text-align:center;
  padding:35px;
  border-top:1px solid #29233b;
  color:#888;
}

@media(max-width:700px){
  nav a{
    display:none;
  }

  .stats{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">
    REHAN'S ROBLOX WORLD
  </div>

  <div>
    <a href="#home">HOME</a>
    <a href="#games">GAMES</a>
    <a href="#history">HISTORY</a>
  </div>
</nav>


<section class="hero" id="home">

  <div class="hero-text">

    <div class="badge">
      WELCOME TO
    </div>

    <h1>
      REHAN'S<br>
      <span>ROBLOX WORLD</span>
    </h1>

    <p>
      My Roblox journey, favourite games,
      achievements and fun mini games!
    </p>

    <a class="btn" href="#games">
      FAVOURITE GAMES
    </a>

    <a class="btn alt" href="#mini-game">
      PLAY MINI GAME
    </a>

    <div class="stats">

      <div class="card stat">
        <b>0</b>
        <small>ROBUX</small>
      </div>

      <div class="card stat">
        <b>2021</b>
        <small>JOINED ROBLOX</small>
      </div>

      <div class="card stat">
        <b>🎯 1/100</b>
        <small>SUBSCRIBER GOAL</small>
      </div>

    </div>

  </div>

</section>


<section class="profile-history">

  <h2>👤 Roblox Profile History</h2>

  <div class="history-card">

    <p>🎮 Roblox Player</p>

    <p>🏆 Games Played: Updating...</p>

    <p>⭐ Favorite Game: Secret Killer</p>

    <p>📅 Player since: 2021</p>

  </div>

</section>


<section class="sub-goal">

  <h2>🎯 BroSis_Gaming Subscriber Goal</h2>

  <div class="goal-box">

    <div class="goal-text">
      1 / 100 Subscribers
    </div>

    <div class="progress-bg">
      <div id="progressBar"></div>
    </div>

    <p>
      🔥 Road to 100 subscribers!
    </p>

  </div>

</section>


<div class="song-card">

  <h2>🎵 Rehan's Favourite Song</h2>

  <p>
    <b>Bata De</b> — Made by Bixu
  </p>

  <a
    href="https://www.youtube.com/results?search_query=Bixu+Bata+De"
    target="_blank">

    🎧 Listen Now

  </a>

</div>


<section id="mini-game">

  <h2 class="title">
    🎮 <span>COIN RUSH</span>
  </h2>

  <div id="gameBox">

    <div style="padding:15px;font-size:20px;">
      Score:
      <b id="score">0</b>

      &nbsp; | &nbsp;

      Time:
      <b id="time">30</b>
    </div>

    <button id="coin" onclick="collectCoin()">
      🪙
    </button>

    <div id="gameMessage">
      Tap the coin! 🪙
    </div>

  </div>

  <button
    class="play-game"
    onclick="startGame()">

    ▶ PLAY / RESTART

  </button>

</section>


<section id="games">

  <h2 class="title">
    Favourite <span>Games</span> ⭐
  </h2>

  <div class="grid">

    <div class="card game">
      <h3>🎮 Rivals</h3>
      <p>One of my favourite Roblox games.</p>
    </div>

    <div class="card game">
      <h3>🎮 Secret Killer</h3>
      <p>A favourite game on my website.</p>
    </div>

    <div class="card game">
      <h3>🎮 Hillside Lake SHOWCASE</h3>
      <p>Beautiful graphics and relaxing gameplay.</p>
    </div>

    <div class="card game">
      <h3>🎮 99 Nights</h3>
      <p>Survival challenge!</p>
    </div>

  </div>

</section>


<section id="history">

  <h2 class="title">
    Roblox <span>History</span> 📜
  </h2>

  <div class="card timeline">

    <div class="item">

      <div class="year">
        2021
      </div>

      <b>
        Joined Roblox
      </b>

      <p>
        My Roblox journey begins.
      </p>

    </div>


    <div class="item">

      <div class="year">
        2022–2023
      </div>

      <b>
        Explored & Played
      </b>

      <p>
        Played different Roblox experiences.
      </p>

    </div>


    <div class="item">

      <div class="year">
        2024–Now
      </div>

      <b>
        Still Grinding!
      </b>

      <p>
        Creating, exploring and enjoying Roblox.
      </p>

    </div>

  </div>

</section>


<footer>
  REHAN'S ROBLOX WORLD • Made for Roblox fans 🎮
</footer>


<script>

let score = 0;
let time = 30;
let timer;
let playing = false;


function startGame(){

  score = 0;
  time = 30;
  playing = true;

  document.getElementById("score").textContent = score;

  document.getElementById("time").textContent = time;

  document.getElementById("gameMessage").textContent =
    "Tap the coin! 🪙";

  moveCoin();

  clearInterval(timer);

  timer = setInterval(function(){

    time--;

    document.getElementById("time").textContent = time;

    if(time <= 0){

      clearInterval(timer);

      playing = false;

      document.getElementById("gameMessage").textContent =
        "🏆 Game Over! Your Score: " + score;

    }

  },1000);

}


function collectCoin(){

  if(!playing){
    return;
  }

  score++;

  document.getElementById("score").textContent = score;

  moveCoin();

}


function moveCoin(){

  const coin =
    document.getElementById("coin");

  const box =
    document.getElementById("gameBox");

  const x =
    Math.random() * (box.clientWidth - 80) + 40;

  const y =
    Math.random() * (box.clientHeight - 130) + 80;

  coin.style.left =
    x + "px";

  coin.style.top =
    y + "px";

}

</script>

</body>
</html>
