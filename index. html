<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rehan's Roblox World</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#05050a;
  color:#fff;
  line-height:1.5;
}

nav{
  position:sticky;
  top:0;
  z-index:10;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 6%;
  background:rgba(5,5,10,.94);
  border-bottom:1px solid #6f35ff;
  backdrop-filter:blur(10px);
}

.logo{
  font-size:22px;
  font-weight:800;
  color:#a66cff;
}

nav a{
  color:#ddd;
  text-decoration:none;
  margin-left:22px;
  font-size:14px;
}

nav a:hover{color:#b77cff}

.hero{
  min-height:70vh;
  padding:70px 6%;
  display:flex;
  align-items:center;
  background:
    radial-gradient(circle at 75% 35%,rgba(126,55,255,.28),transparent 30%),
    linear-gradient(135deg,#090912,#13072b 55%,#05050a);
}

.hero-text{max-width:620px}

.badge{
  color:#a66cff;
  font-weight:800;
  letter-spacing:2px;
}

h1{
  font-size:clamp(44px,8vw,82px);
  line-height:.95;
  margin:15px 0;
}

h1 span{color:#9b55ff}

.hero p{
  color:#bbb;
  max-width:520px;
  margin:20px 0;
}

.btn{
  display:inline-block;
  padding:13px 22px;
  border-radius:10px;
  text-decoration:none;
  color:white;
  font-weight:700;
  margin-right:10px;
  background:linear-gradient(90deg,#6b25ff,#4d8dff);
}

.btn.alt{
  background:transparent;
  border:1px solid #8d43ff;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  margin-top:30px;
}

.card{
  background:linear-gradient(145deg,#11111c,#0b0b12);
  border:1px solid #29233b;
  border-radius:16px;
  padding:20px;
}

.stat b{
  display:block;
  font-size:27px;
}

.stat small{color:#999}

section{padding:60px 6%}

.title{
  font-size:32px;
  margin-bottom:24px;
}

.title span{color:#a55cff}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
}

.game h3{margin-bottom:5px}
.game p{color:#999}

.timeline .item{
  border-left:3px solid #8d43ff;
  padding:0 0 25px 20px;
  margin-left:8px;
}

.timeline .year{
  color:#a55cff;
  font-weight:800;
}

.profile-history,
.sub-goal{
  margin:25px auto;
  max-width:600px;
  text-align:center;
}

.history-card,
.goal-box{
  background:#202020;
  padding:20px;
  border-radius:18px;
}

.history-card p{margin:10px 0}

.goal-text{
  font-size:22px;
  font-weight:bold;
  margin-bottom:15px;
}

.progress-bg{
  width:100%;
  height:18px;
  background:#444;
  border-radius:20px;
  overflow:hidden;
}

#progressBar{
  width:0%;
  height:100%;
  background:#00ff66;
  transition:.5s;
}

#goalMessage{margin-top:15px}

.song-card{
  max-width:420px;
  margin:30px auto;
  padding:25px;
  text-align:center;
  border-radius:20px;
  background:#1d1d1d;
}

.song-card a{
  display:inline-block;
  margin-top:15px;
  padding:12px 22px;
  border-radius:30px;
  background:white;
  color:#111;
  text-decoration:none;
  font-weight:bold;
}

#roblox-profile{
  text-align:center;
}

#roblox-profile input{
  padding:12px;
  border-radius:8px;
  border:1px solid #aaa;
}

#roblox-profile button{
  padding:12px 18px;
  border:0;
  border-radius:8px;
  cursor:pointer;
}

.profile-card{
  margin:20px auto;
  padding:20px;
  max-width:400px;
  border-radius:15px;
  background:#f2f2f2;
  color:#111;
}

.profile-card img{
  width:150px;
  border-radius:15px;
}

.profile-card a{
  font-weight:bold;
  text-decoration:none;
}

#mini-game{
  text-align:center;
}

#gameBox{
  max-width:600px;
  height:350px;
  margin:auto;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#12052b,#090912);
  border:2px solid #8d43ff;
  border-radius:20px;
}

#coin{
  position:absolute;
  left:50%;
  top:55%;
  width:65px;
  height:65px;
  transform:translate(-50%,-50%);
  border:0;
  border-radius:50%;
  background:#ffd43b;
  font-size:30px;
  cursor:pointer;
}

#gameMessage{
  position:absolute;
  bottom:20px;
  width:100%;
  color:#bbb;
  font-weight:bold;
}

.play-game{
  margin-top:18px;
  padding:13px 25px;
  border:0;
  border-radius:10px;
  background:linear-gradient(90deg,#6b25ff,#4d8dff);
  color:white;
  font-weight:bold;
  cursor:pointer;
}

footer{
  text-align:center;
  padding:35px 6%;
  border-top:1px solid #29233b;
  color:#888;
}

@media(max-width:700px){
  nav a{display:none}
  .stats{grid-template-columns:1fr}
}
</style>
</head>

